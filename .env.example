USERIO_DB_PATH=/var/lib/universal-userio/userio.sqlite3
USERIO_API_TOKEN=
USERIO_HOST=127.0.0.1
USERIO_PORT=18093
# Optional path; defaults to the gitignored .env.owner-seed in the working directory.
USERIO_OWNER_SEED_FILE=.env.owner-seed
# Optional shared secret injected by a trusted dashboard reverse proxy.
USERIO_TRUSTED_PROXY_TOKEN=

# OpenAI-compatible /v1 base URL, model and UserIO-only credential.
USERIO_AI_ENDPOINT=http://127.0.0.1:4000/v1
USERIO_AI_MODEL=MiniMax-M2.7
USERIO_AI_IMAGE_MODEL=MiniMax-M3.1-Flash
# Optional; defaults to USERIO_AI_MODEL.
# USERIO_AI_SUMMARY_MODEL=MiniMax-M2.7
USERIO_AI_TOKEN=

# Routes refer to a token environment variable; tokens do not appear in JSON.
USERIO_ROUTES_JSON={"telegram-reply":{"event_url":"http://127.0.0.1:8091","token_env":"NOTICEPLACE_TELEGRAM_TOKEN","project":"userio"}}

# Optional Android SMS Gateway channel. Keep this token server-side; UserIO only sends after approve_send.
USERIO_SMS_GATEWAY_URL=http://127.0.0.1:8787
USERIO_SMS_GATEWAY_TOKEN=replace-with-android-sms-gateway-api-key
USERIO_SMS_ROUTE_ID=sms
# USERIO_SMS_USER_ID=owner-user-id
NOTICEPLACE_TELEGRAM_TOKEN=

# Gmail ingress owner notifications. The token must be scoped to project
# "userio" in NoticePlace. Stable per-message idempotency prevents duplicates.
USERIO_NOTICEPLACE_EVENT_URL=http://127.0.0.1:8091/v1/events
USERIO_NOTICEPLACE_TOKEN=
USERIO_NOTICEPLACE_PROJECT=userio
USERIO_NOTICEPLACE_RECIPIENT=me
USERIO_GMAIL_SNAPSHOT_SIZE=500

# Matrix voice is an audio transport around the running AgentCall engine.
# TTS/model/tempo/STT settings are inherited from agentcall-gatewayd, never reset here.
# Optional extra: uv pip install 'universal-userio[matrix-calls]'
USERIO_MATRIX_RTC_AUTH_URL=https://rtc.example.org
# Fixed Notice Place bridge destination. Use the existing protected bridge token.
USERIO_MATRIX_NOTICE_ACCOUNT=matrix:connected-caller-id
USERIO_MATRIX_NOTICE_ROOM=!existing-direct-room:example.org
USERIO_MATRIX_NOTICE_TARGET=@owner:example.org
USERIO_MATRIX_NOTICE_TOKEN=
# Notice Place Telegram calls use an explicitly approved existing caller/owner.
# These must be set separately; generic relay read/source peers are never dial targets.
# The existing USERIO_MATRIX_NOTICE_TOKEN protects both Notice Place call routes.
USERIO_TELEGRAM_NOTICE_ACCOUNT=telegram:existing-approved-caller-id
USERIO_TELEGRAM_NOTICE_TARGET=approved-owner-telegram-id
