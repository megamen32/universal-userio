#!/usr/bin/env python3
"""Print one locally stored Gmail App Password for Himalaya."""
import re
import sys
from pathlib import Path

if len(sys.argv) != 2 or not re.fullmatch(r"[A-Za-z0-9_-]{1,80}", sys.argv[1]):
    raise SystemExit("invalid account alias")
path = Path("/home/roomhacker/.hermes/secrets/universal-userio-gmail") / sys.argv[1]
if not path.is_file():
    raise SystemExit("Gmail App Password is not configured")
value = path.read_text(encoding="utf-8").strip()
if not value:
    raise SystemExit("Gmail App Password is empty")
print(value)
