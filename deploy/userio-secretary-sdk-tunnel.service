[Unit]
Description=UserIO private transport to the fixed native Secretary SDK
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=roomhacker
Group=roomhacker
SupplementaryGroups=notification-center
Environment=HOME=/home/roomhacker
ExecStart=/usr/bin/python3 /usr/local/lib/userio/secretary_sdk_tunnel.py
Restart=always
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
