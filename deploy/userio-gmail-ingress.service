[Unit]
Description=Universal UserIO Gmail ingress
After=network-online.target universal-userio.service
Wants=network-online.target
Requires=universal-userio.service
PartOf=universal-userio.service

[Service]
Type=simple
User=roomhacker
WorkingDirectory=/opt/universal-userio
EnvironmentFile=/etc/universal-userio.env
Environment=PYTHONPATH=/opt/universal-userio/src
Environment=USERIO_HIMALAYA_BIN=/home/roomhacker/.cargo/bin/himalaya
Environment=USERIO_GMAIL_ACCOUNTS_FILE=/var/lib/universal-userio/gmail-accounts.txt
Environment=USERIO_INGRESS_URL=http://127.0.0.1:18093
ExecStart=/usr/bin/python3 -m universal_userio.gmail_ingress
Restart=always
RestartSec=5
MemoryHigh=64M
MemoryMax=128M
MemorySwapMax=32M
CPUQuota=25%
TasksMax=16
IOWeight=25

[Install]
WantedBy=universal-userio.service
