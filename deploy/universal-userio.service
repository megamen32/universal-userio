[Unit]
Description=Universal UserIO business control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/universal-userio
Environment=PYTHONPATH=/opt/universal-userio/src
EnvironmentFile=/etc/universal-userio.env
ExecStart=/usr/bin/python3 -m universal_userio.runtime
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/universal-userio
MemoryHigh=128M
MemoryMax=256M
MemorySwapMax=64M
CPUQuota=100%
TasksMax=64
IOWeight=50

[Install]
WantedBy=multi-user.target
