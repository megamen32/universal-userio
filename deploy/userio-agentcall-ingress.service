[Unit]
Description=Project AgentCall events into Universal UserIO
After=agentcall-gatewayd.service universal-userio.service
Requires=agentcall-gatewayd.service universal-userio.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/universal-userio
Environment=PYTHONPATH=/opt/universal-userio/src
Environment=USERIO_PHONE_ROUTE_ID=phone
Environment=USERIO_ACCOUNT_ID=phone100
Environment="USERIO_PHONE_LABEL=S21 AI call"
EnvironmentFile=/etc/universal-userio.env
ExecStart=/usr/bin/python3 -m universal_userio.agentcall_ingress
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
MemoryHigh=128M
MemoryMax=128M
MemorySwapMax=16M
CPUQuota=50%
TasksMax=16
IOWeight=50

[Install]
WantedBy=multi-user.target
