{
  "manifest_version": 3,
  "name": "Universal UserIO Agent",
  "version": "0.3.0",
  "description": "VK Web inbox capture plus universal site data collection: fetch tasks from your UserIO server, executed with the browser's own sessions.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Universal UserIO Agent"
  },
  "content_scripts": [
    {
      "matches": ["https://vk.com/*", "https://vk.ru/*"],
      "js": ["lib/selectors.js", "content/chat-list.js", "content/chat-view.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "options.html"
}
