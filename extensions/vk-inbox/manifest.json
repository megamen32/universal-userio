{
  "manifest_version": 3,
  "key": "",
  "name": "Universal UserIO Agent",
  "version": "0.9.38",
  "description": "VK and ChatGPT conversations in work and personal UserIO. Choose accounts for each destination and connect Agent Herder.",
  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "alarms",
    "scripting",
    "activeTab",
    "cookies",
    "identity"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Universal UserIO Agent"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content/chatgpt-passive-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content/chatgpt-fetch-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://vk.com/*",
        "https://vk.ru/*"
      ],
      "js": [
        "lib/selectors.js",
        "content/chat-list.js",
        "content/chat-view.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "web_accessible_resources": []
}
