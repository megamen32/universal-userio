{
  "manifest_version": 3,
  "key": "",
  "name": "Universal UserIO Agent",
  "version": "0.7.0",
  "description": "VK Web inbox capture, long-poll command channel, and a session vault: back up cookies/localStorage to the cloud (UserIO server or Yandex Disk) and restore them on another machine. MV3 service worker.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting",
    "activeTab",
    "cookies"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Universal UserIO Agent"
  },
  "content_scripts": [
    {
      "matches": ["https://vk.com/*", "https://vk.ru/*"],
      "js": ["lib/selectors.js", "content/chat-list.js", "content/chat-view.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "web_accessible_resources": []
}
