{
  "manifest_version": 3,
  "name": "Universal UserIO — VK",
  "version": "0.2.0",
  "description": "Real-time VK Web chat capture, search, and send via the existing browser session. Forwards to UserIO and reads inbox back.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://vk.com/*",
    "https://vk.ru/*",
    "https://msg.bezrabotnyi.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Universal UserIO · VK"
  },
  "content_scripts": [
    {
      "matches": ["https://vk.com/*", "https://vk.ru/*"],
      "js": ["lib/selectors.js", "content/chat-list.js", "content/chat-view.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "options.html"
}
