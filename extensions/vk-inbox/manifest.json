{
  "manifest_version": 3,
  "key": "",
  "name": "Universal UserIO Agent",
  "version": "0.4.0",
  "description": "VK Web inbox capture plus a long-poll command channel that lets the operator drive the real logged-in browser. MV3 service worker.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://vk.com/*",
    "https://vk.ru/*",
    "https://userapi.com/*",
    "https://sun1.userapi.com/*",
    "https://sun9.userapi.com/*",
    "https://pp.userapi.com/*",
    "http://192.168.2.100/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Universal UserIO Agent"
  },
  "content_scripts": [
    {
      "matches": ["https://vk.com/*", "https://vk.ru/*"],
      "js": ["lib/selectors.js", "content/chat-list.js", "content/chat-view.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "web_accessible_resources": []
}
